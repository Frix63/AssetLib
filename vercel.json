{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/assetlib/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/assetlib/downloads/(.*)",
      "destination": "/downloads/$1"
    },
    {
      "source": "/assetlib/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/assetlib/llms-full.txt",
      "destination": "/llms-full.txt"
    },
    {
      "source": "/assetlib/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/assetlib/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/assetlib/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/assetlib",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
